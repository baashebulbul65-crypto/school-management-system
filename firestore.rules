rules_version = '2';

// Fiiri README-ka qaybta "Firestore Rules" ka hor intaadan wax beddelin halkan.
//
// MUHIIM: Collection-ka 'staff' (liiska macallimiinta/shaqaalaha ee bogga
// "Users") WELI kuma jiro Firestore — 'users/{uid}' baa xogta shaqaalaha
// dhabta ah ku haysa. Marka la beddelo, waa in halkan loo daraa qaybo
// cusub oo la mid ah kuwa hoose.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 'users/{uid}' doc-ka isticmaale kasta — ka akhri role/schoolCode/childrenIds.
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStaffOf(schoolCode) {
      return isSignedIn() && me().accountType == 'staff' && me().schoolCode == schoolCode;
    }

    function isParentAccount() {
      return isSignedIn() && me().accountType == 'student-parent';
    }

    // Waalid/Arday oo isku dugsi (schoolCode) ah — loo baahan si loo ogolaado
    // raadinta arday (Diiwaan ID) marka la xiraayo ilmo cusub (fiiri README).
    function isSameSchoolParent(schoolCode) {
      return isParentAccount() && me().schoolCode == schoolCode;
    }

    // Waalidka ilmahan gaarka ah — 'childrenIds' array-ka 'users' doc-kiisa.
    function isParentOfStudent(schoolCode, studentId) {
      return isSameSchoolParent(schoolCode) && studentId in me().childrenIds;
    }

    // ===== users =====
    // Isticmaale kastaa wuxuu akhriyi/beddeli karaa profile-kiisa. Waxaa sidoo
    // kale u ogolaaday 'owner' inuu maamulo (abuur/akhri/beddel/saar) shaqaalaha
    // kale ee isla dugsigiisa (bogga "Users") — fiiri firebase/staff.js.
    match /users/{userId} {
      // MUHIIM (security fix, 2026-08-01): "self-create" waa in ay kaliya u
      // ogolaataa 'student-parent' — haddii kale isticmaale kastaa (SDK-ga
      // Firestore si toos ah, ma aha kaliya UI-ga app-ka) wuxuu qori karaa
      // users/{naftiisa} isagoo dhigaya accountType:'staff', role:'owner',
      // schoolCode: DUGSI KASTA — taasoo siin lahayd gelitaan owner-nimo oo
      // BUUXA dugsi uusan lahayn (registerStaff() ma isticmaasho UI-gu hadda,
      // marka self-create ee 'staff' looma baahna).
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.accountType == 'student-parent')
        || (me().accountType == 'staff' && me().role == 'owner'
            && me().schoolCode == request.resource.data.schoolCode
            && request.resource.data.accountType == 'staff')
      );
      allow read: if isSignedIn() && (
        request.auth.uid == userId
        || (me().accountType == 'staff' && me().role == 'owner'
            && me().schoolCode == resource.data.schoolCode && resource.data.accountType == 'staff')
      );
      // MUHIIM (security fix, 2026-08-01): "self-update" waa in ay kaliya u
      // ogolaataa field-ka "childrenIds" (isla kii "Ku Dar Ilmo Kale" isticmaalo,
      // fiiri firebase/auth.js: addChildToParent) — haddii kale isticmaale
      // kastaa wuxuu isu beddeli lahaa role/accountType/schoolCode naftiisa
      // (owner-nimo dugsi kasta) isaga oo aan la joogin xaqiijin kale.
      allow update: if isSignedIn() && (
        (request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['childrenIds']))
        || (me().accountType == 'staff' && me().role == 'owner'
            && me().schoolCode == resource.data.schoolCode && resource.data.accountType == 'staff'
            && request.resource.data.schoolCode == resource.data.schoolCode)
      );
      // Ma tirtiro Firebase Auth account-ka (SDK-ga browser-ku uma oggola —
      // waa loo baahan yahay Admin SDK/backend), laakiin tirtiridda doc-kan
      // waa in ay xannibto gelitaanka oo dhan (fiiri firebase/staff.js:
      // removeStaffDoc) — ma iska saari karo naftaada.
      allow delete: if isSignedIn() && me().accountType == 'staff' && me().role == 'owner'
        && me().schoolCode == resource.data.schoolCode && resource.data.accountType == 'staff'
        && request.auth.uid != userId;
    }

    // ===== schools (magaca, logo-ga, fees-by-grade, sanadka waxbarasho,
    // notification prefs ee dugsiga) — doc id-gu waa schoolCode-ka lafteeda
    // (deterministic, fiiri firebase/schools.js). Akhris: qof kasta oo isku
    // dugsi ah (shaqaale + waalid — magaca/logo-ga waa in waalidku sidoo
    // kale arkaa). Qoris: owner kaliya, la mid ah bogga "Settings" ee UI-gu
    // owner-only u yahay.
    match /schools/{schoolCode} {
      allow read: if isSignedIn() && me().schoolCode == resource.data.schoolCode;
      // MUHIIM (security fix, 2026-08-01): waxaa lagu xaddiday doc ID-ga
      // dhabta ah (path variable "schoolCode"), ma aha field-ka
      // request.resource.data.schoolCode — hore waxaa suurtagal ahaa in
      // owner dugsi A ah uu ku qoro/burburiyo doc-ka schools/{dugsi B} isaga
      // oo isticmaalaya schoolCode-kiisa (A) gudaha payload-ka.
      allow create, update: if isStaffOf(schoolCode) && me().role == 'owner';
      allow delete: if false;
    }

    // ===== students =====
    // Akhris: Shaqaalaha dugsigaas + kaliya Waalidka runtida ah ee ilmahan
    // (childrenIds). Raadinta Diiwaan ID marka ilmo la xirayo waxay isticmaashaa
    // collection-ka 'studentLookup' (fiiri hoos) — ma aha in Waalid kasta
    // uu akhrin karo dhammaan xogta ardayda dugsiga (magac, taleefan, lacag,
    // natiijooyin, iwm) sida hore laga sameyn jiray.
    match /students/{studentDocId} {
      allow read: if isStaffOf(resource.data.schoolCode) || isParentOfStudent(resource.data.schoolCode, studentDocId);
      allow create: if isStaffOf(request.resource.data.schoolCode);
      allow update: if isStaffOf(resource.data.schoolCode);
      // Tirtiridda joogtada ah (permanent delete, "Trash") waa mid aan la soo
      // celin karin — waxaa loo xaddidayaa 'owner' kaliya, si la mid ah sida
      // bogga "Trash" ee UI-gu owner-only u yahay.
      allow delete: if isStaffOf(resource.data.schoolCode) && me().role == 'owner';
    }

    // ===== studentLookup =====
    // Doc gaaban oo kaliya leh {schoolCode, studentId, studentDocId} — waxaa
    // loo isticmaalaa raadinta Diiwaan ID (waalid marka ilmo la xirayo) iyada
    // oo aan loo baahnayn in Waalidku helo full document-ka ardayga ee
    // 'students'. Doc ID-gu waa deterministic: schoolCode_studentId.
    match /studentLookup/{lookupId} {
      allow read: if isStaffOf(resource.data.schoolCode) || isSameSchoolParent(resource.data.schoolCode);
      allow create, update: if isStaffOf(request.resource.data.schoolCode);
      allow delete: if isStaffOf(resource.data.schoolCode);
    }

    // ===== teachers =====
    // Akhris: shaqaale kasta (loo baahan yahay ClassWorkspace "jadwalka
    // maanta" ee macallin kasta arki karo). Qorista (add/edit) waxaa loo
    // xaddiday 'owner' kaliya, si la mid ah bogga "Macallimiinta" ee UI-gu
    // owner-only u yahay.
    match /teachers/{teacherId} {
      allow read: if isStaffOf(resource.data.schoolCode);
      allow create, update: if isStaffOf(request.resource.data.schoolCode) && me().role == 'owner';
      allow delete: if false;
    }

    // ===== classes ===== — shaqaale kastaa wuu maamuli karaa (bogga
    // "Fasallada" uma xayirna owner kaliya).
    // MUHIIM (bug fix, 2026-08-01): "create" waxaa loo isticmaali jiray
    // resource.data (kaas oo aan jirin marka doc-ku CUSUB yahay — Firestore
    // Rules "resource" waa null marka la abuurayo) — taasi waxay keenaysay in
    // "create" mar walba la XANNIBO si khalad ah, xitaa shaqaale sax ah.
    match /classes/{classDocId} {
      allow read, update, delete: if isStaffOf(resource.data.schoolCode);
      allow create: if isStaffOf(request.resource.data.schoolCode);
    }

    // ===== subjects ===== — la mid ah classes (shaqaale kastaa wuu maamuli karaa).
    match /subjects/{subjectId} {
      allow read, update, delete: if isStaffOf(resource.data.schoolCode);
      allow create: if isStaffOf(request.resource.data.schoolCode);
    }

    // ===== exams ===== (qeexidda imtixaanka — fiiri examMarks ee buundada
    // ardaygu ku qaatay) — shaqaale kastaa wuu maamuli karaa.
    match /exams/{examId} {
      allow read, update, delete: if isStaffOf(resource.data.schoolCode);
      allow create: if isStaffOf(request.resource.data.schoolCode);
    }

    // ===== attendanceRecords ===== (doc id: "{date}_{studentId}")
    match /attendanceRecords/{recordId} {
      allow read: if isStaffOf(resource.data.schoolCode) || isParentOfStudent(resource.data.schoolCode, resource.data.studentId);
      allow create, update: if isStaffOf(request.resource.data.schoolCode);
      allow delete: if false;
    }

    // ===== staffRoster ===== — liiska shaqaalaha aan macallimiinta ahayn
    // (Maamule, Xisaabiye, Ilaaliye, iwm) ee bogga Attendance tabka "Staff" —
    // shaqaale kastaa wuu maamuli karaa, la mid ah classes/subjects.
    match /staffRoster/{rosterId} {
      allow read, update, delete: if isStaffOf(resource.data.schoolCode);
      allow create: if isStaffOf(request.resource.data.schoolCode);
    }

    // ===== staffAttendanceRecords ===== (doc id: "{category}_{date}_{personId}")
    // Imaanshaha "maanta" ee macallimiinta/shaqaalaha — staff-only, ma jiro
    // akhris waalid (kama duwana attendanceRecords ee ardayda).
    match /staffAttendanceRecords/{recordId} {
      allow read: if isStaffOf(resource.data.schoolCode);
      allow create, update: if isStaffOf(request.resource.data.schoolCode);
      allow delete: if false;
    }

    // ===== examMarks ===== (doc id: "{examId}_{studentId}")
    match /examMarks/{recordId} {
      allow read: if isStaffOf(resource.data.schoolCode) || isParentOfStudent(resource.data.schoolCode, resource.data.studentId);
      allow create, update: if isStaffOf(request.resource.data.schoolCode);
      allow delete: if false;
    }

    // ===== quranProgress ===== (doc id: "{date}_{studentId}")
    match /quranProgress/{recordId} {
      allow read: if isStaffOf(resource.data.schoolCode) || isParentOfStudent(resource.data.schoolCode, resource.data.studentId);
      allow create, update: if isStaffOf(request.resource.data.schoolCode);
      allow delete: if false;
    }

    // ===== quranTargets =====
    match /quranTargets/{targetId} {
      allow read: if isStaffOf(resource.data.schoolCode) || isParentOfStudent(resource.data.schoolCode, resource.data.studentId);
      allow create, update: if isStaffOf(request.resource.data.schoolCode);
      allow delete: if false;
    }

    // ===== messages (Waalid <-> Shaqaale) =====
    match /messages/{messageId} {
      allow read: if isStaffOf(resource.data.schoolCode) || isParentOfStudent(resource.data.schoolCode, resource.data.studentId);

      allow create: if
        (isStaffOf(request.resource.data.schoolCode)
          && request.resource.data.senderRole == 'staff'
          && request.resource.data.senderId == request.auth.uid)
        ||
        (isParentOfStudent(request.resource.data.schoolCode, request.resource.data.studentId)
          && request.resource.data.senderRole == 'parent'
          && request.resource.data.senderId == request.auth.uid);

      // Kaliya calaamadinta "la akhriyay" (readByStaff/readByParent) ayaa la
      // ogolaanayaa — qoraalka fariinta lama badali karo.
      allow update: if
        (isStaffOf(resource.data.schoolCode)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByStaff']))
        ||
        (isParentOfStudent(resource.data.schoolCode, resource.data.studentId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByParent']));

      allow delete: if false;
    }

    // ===== financeExpenses / financeIncome =====
    match /financeExpenses/{expenseId} {
      allow read: if isStaffOf(resource.data.schoolCode);
      allow create: if isStaffOf(request.resource.data.schoolCode);
      allow update, delete: if false;
    }
    match /financeIncome/{incomeId} {
      allow read: if isStaffOf(resource.data.schoolCode);
      allow create: if isStaffOf(request.resource.data.schoolCode);
      allow update, delete: if false;
    }

    // ===== classFees / familyFees ===== — qeexidda safka (name/students/
    // total/discount) KALIYA, balance-ku KUMA jiro halkan (waxaa laga soo
    // xisaabiyaa "feePayments" ee hoose, fiiri SchoolDataContext.jsx).
    match /classFees/{rowId} {
      allow read: if isStaffOf(resource.data.schoolCode);
      allow create: if isStaffOf(request.resource.data.schoolCode);
      allow update, delete: if false;
    }
    match /familyFees/{rowId} {
      allow read: if isStaffOf(resource.data.schoolCode);
      allow create: if isStaffOf(request.resource.data.schoolCode);
      allow update, delete: if false;
    }

    // ===== feePayments ===== — diiwaan (ledger) bixin kasta, APPEND-ONLY:
    // marna lama badali karo, lamana tirtiri karo (sixitaanku waxaa lagu
    // sameeyaa diiwaan celceliya, ma aha in taariikhda la tafatiro).
    // Waalidku wuxuu akhrin karaa KELIYA bixinnada ilmihiisa, oo KELIYA
    // feeType=='student' (M.Qoys/Fasal safafkoodu ma lahan studentId dhab
    // ah — sidaas darteed waxaa lagu xaddiday nooca doc-ga ka hor inta aan
    // la eegin studentId, si aan looga fogaan khalad "field missing" ah).
    match /feePayments/{paymentId} {
      allow read: if isStaffOf(resource.data.schoolCode)
        || (resource.data.feeType == 'student' && isParentOfStudent(resource.data.schoolCode, resource.data.studentId));
      allow create: if isStaffOf(request.resource.data.schoolCode);
      allow update, delete: if false;
    }

    // ===== financeSalaries ===== — "status" (pending/paid) kaliya ayaa la
    // beddeli karaa (fiiri firebase/finance.js: setSalaryStatus).
    match /financeSalaries/{salaryId} {
      allow read: if isStaffOf(resource.data.schoolCode);
      allow create: if isStaffOf(request.resource.data.schoolCode);
      allow update: if isStaffOf(resource.data.schoolCode)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // ===== financeDiscounts / financeDocuments ===== — diiwaan, APPEND-ONLY.
    match /financeDiscounts/{discountId} {
      allow read: if isStaffOf(resource.data.schoolCode);
      allow create: if isStaffOf(request.resource.data.schoolCode);
      allow update, delete: if false;
    }
    match /financeDocuments/{documentId} {
      allow read: if isStaffOf(resource.data.schoolCode);
      allow create: if isStaffOf(request.resource.data.schoolCode);
      allow update, delete: if false;
    }

    // ===== notifications =====
    // Fiiri notifications.js: "createFeeNotification"/"createAbsentNotification"
    // waxay isticmaalaan setDoc si ay ugu dib-u-cusboonaysiiyaan (refresh) hal
    // doc-ID oo go'an marar badan (mar kasta oo baaqigu/maqnaanshuhu dib loo
    // eego) — sidaas darteed shaqaalaha waa in ay si buuxda u update-gareyn
    // karaan (ma aha kaliya calaamadinta readByStaff). Waalidku wuxuu kaliya
    // beddeli karaa "readByParent".
    match /notifications/{notificationId} {
      allow read: if isStaffOf(resource.data.schoolCode) || isParentOfStudent(resource.data.schoolCode, resource.data.studentId);
      allow create: if isStaffOf(request.resource.data.schoolCode);

      allow update: if
        isStaffOf(request.resource.data.schoolCode)
        ||
        (isParentOfStudent(resource.data.schoolCode, resource.data.studentId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByParent']));

      allow delete: if isStaffOf(resource.data.schoolCode);
    }

    // Wax kasta oo aan kor lagu qorin — xayiran si toos ah.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
