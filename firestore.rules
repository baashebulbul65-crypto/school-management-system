rules_version = '2';

// Fiiri README-ka qaybta "Firestore Rules" ka hor intaadan wax beddelin halkan.
//
// MUHIIM: Collection-ka 'staff' (liiska macallimiinta/shaqaalaha ee bogga
// "Users") WELI kuma jiro Firestore — 'users/{uid}' baa xogta shaqaalaha
// dhabta ah ku haysa. Marka la beddelo, waa in halkan loo daraa qaybo
// cusub oo la mid ah kuwa hoose.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 'users/{uid}' doc-ka isticmaale kasta — ka akhri role/schoolCode/childrenIds.
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // "status" (Suspend Enforcement, 2026-08-02): shaqaale la joojiyay
    // (status:'suspended', fiiri firebase/staff.js: setStaffStatus) waa in
    // uu KA XANNIBMAA xogta oo dhan halkan (rules-ka), ma aha kaliya UI-ga
    // (Users.jsx badge) ama xannibaadda login-ka ee loginStaff() — haddii
    // kale session horeba furan (browser tab) wuu sii akhrin/qori karaa xog
    // xitaa ka dib markii la joojiyo. .get(...,'active') halkii .status
    // toos ah loo isticmaali lahaa — doc-yada shaqaalaha hore loo abuuray
    // (ka hor 'status' la darin) ma laha field-kan, waa in ay 'active' ahaadaan
    // default ahaan (isla fallback-ka Users.jsx: u.status || 'active'), ma
    // aha in ay khalad (deny) ka dhasho maqnaanshaha field-ka.
    function isStaffOf(schoolCode) {
      return isSignedIn() && me().accountType == 'staff' && me().schoolCode == schoolCode
        && me().get('status', 'active') != 'suspended';
    }

    // Sida isStaffOf, laakiin waxay sidoo kale hubisaa in doorku yahay
    // 'owner' — waxaa loo isticmaalaa xogta owner-ku kaliya arki/maamuli karo
    // (Finance-ka oo dhan, add/edit/delete fasal, abuurista arday cusub),
    // si 'teacher' aanu si toos ah Firestore SDK-ka ugu marin xannibaadda
    // UI/route-ka (fiiri README: Teacher Role Scoping audit, 2026-08-02).
    function isOwnerStaffOf(schoolCode) {
      return isStaffOf(schoolCode) && me().role == 'owner';
    }

    // Teacher Firestore Hardening (2026-08-02): waxaa loo isticmaalaa
    // attendanceRecords/notifications — macallinku wuxuu si toos ah Firestore
    // uga akhrin karaa KALIYA records-ka fasalladiisa gaarka ah, ma aha
    // fasallada kale/xogta guud ee dugsiga (xitaa haddii uu isku dayo
    // query/get toos ah oo aan mari doonin UI-ga). recordClassTeacherId waa
    // field "classTeacherId" ee record-ka (denormalized marka la abuurayo,
    // fiiri firebase/attendance.js iyo notifications.js) — records-kii hore
    // ee aan lahayn field-kan (ka hor backfill-ka) waxay noqonayaan null
    // marka la akhriyo (get(...,null)), taasoo macallinku u xannibaysa (owner
    // ayaa arka dhammaantood xitaa kuwa hore).
    function isMyClassData(schoolCode, recordClassTeacherId) {
      return isOwnerStaffOf(schoolCode)
        || (isStaffOf(schoolCode) && me().role == 'teacher'
            && recordClassTeacherId != null && recordClassTeacherId == me().teacherDocId);
    }

    function isParentAccount() {
      return isSignedIn() && me().accountType == 'student-parent';
    }

    // Waalid/Arday oo isku dugsi (schoolCode) ah — loo baahan si loo ogolaado
    // raadinta arday (Diiwaan ID) marka la xiraayo ilmo cusub (fiiri README).
    function isSameSchoolParent(schoolCode) {
      return isParentAccount() && me().schoolCode == schoolCode;
    }

    // Waalidka ilmahan gaarka ah — 'childrenIds' array-ka 'users' doc-kiisa.
    function isParentOfStudent(schoolCode, studentId) {
      return isSameSchoolParent(schoolCode) && studentId in me().childrenIds;
    }

    // "Ilmahan (childId) ma ku jiraa fasalka (classId)" — waxaa loo isticmaalaa
    // 'exams' (fiiri hoos), maadaama imtixaanku uu ku xiran yahay fasal
    // (classId), ma aha arday gaar ah (studentId) sida collections-ka kale.
    function childInClass(childId, classId) {
      return childId != null
        && classId != null
        && exists(/databases/$(database)/documents/students/$(childId))
        && get(/databases/$(database)/documents/students/$(childId)).data.get('classId', null) == classId;
    }

    // Waalidka fasalka — mid ka mid ah childrenIds-kiisa (ilaa 5, tiro
    // macquul ah) ku jiraa fasalkan. Rules-ku ma taageeraan loop dhab ah oo
    // liis ah, sidaas darteed waxaa la xaddiday tiro la yaqaan.
    function isParentOfClass(schoolCode, classId) {
      return isSameSchoolParent(schoolCode) && (
        (me().childrenIds.size() > 0 && childInClass(me().childrenIds[0], classId))
        || (me().childrenIds.size() > 1 && childInClass(me().childrenIds[1], classId))
        || (me().childrenIds.size() > 2 && childInClass(me().childrenIds[2], classId))
        || (me().childrenIds.size() > 3 && childInClass(me().childrenIds[3], classId))
        || (me().childrenIds.size() > 4 && childInClass(me().childrenIds[4], classId))
      );
    }

    // ===== users =====
    // Isticmaale kastaa wuxuu akhriyi/beddeli karaa profile-kiisa. Waxaa sidoo
    // kale u ogolaaday 'owner' inuu maamulo (abuur/akhri/beddel/saar) shaqaalaha
    // kale ee isla dugsigiisa (bogga "Users") — fiiri firebase/staff.js.
    // "isOwnerStaffOf(...) && accountType=='staff'" (Suspend Enforcement,
    // 2026-08-02) halkii lagu celcelin lahaa "me().accountType=='staff' &&
    // me().role=='owner'" gudaha afartaas (create/read/update/delete) — si
    // owner la joojiyay (status:'suspended') isaguna uusan u awoodin inuu
    // maamulo shaqaalaha kale intii uu la joojiyay (fiiri isStaffOf kore).
    match /users/{userId} {
      // MUHIIM (security fix, 2026-08-01): "self-create" waa in ay kaliya u
      // ogolaataa 'student-parent' — haddii kale isticmaale kastaa (SDK-ga
      // Firestore si toos ah, ma aha kaliya UI-ga app-ka) wuxuu qori karaa
      // users/{naftiisa} isagoo dhigaya accountType:'staff', role:'owner',
      // schoolCode: DUGSI KASTA — taasoo siin lahayd gelitaan owner-nimo oo
      // BUUXA dugsi uusan lahayn (registerStaff() ma isticmaasho UI-gu hadda,
      // marka self-create ee 'staff' looma baahna).
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.accountType == 'student-parent')
        || (isOwnerStaffOf(request.resource.data.schoolCode)
            && request.resource.data.accountType == 'staff')
      );
      allow read: if isSignedIn() && (
        request.auth.uid == userId
        || (isOwnerStaffOf(resource.data.schoolCode) && resource.data.accountType == 'staff')
      );
      // MUHIIM (security fix, 2026-08-01): "self-update" waa in ay kaliya u
      // ogolaataa field-ka "childrenIds" (isla kii "Ku Dar Ilmo Kale" isticmaalo,
      // fiiri firebase/auth.js: addChildToParent) — haddii kale isticmaale
      // kastaa wuxuu isu beddeli lahaa role/accountType/schoolCode naftiisa
      // (owner-nimo dugsi kasta) isaga oo aan la joogin xaqiijin kale.
      allow update: if isSignedIn() && (
        (request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['childrenIds']))
        // "request.resource.data.accountType == resource.data.accountType" (Audit
        // hardening, 2026-08-02, gap #6) — hore update-ku ma xaqiijin lahayn in
        // 'accountType' weli 'staff' ahaado ka dib update-ka (kaliya doc-gii HORE
        // ayaa la hubin jiray), isla mabda'a schoolCode-ka pin-ka ah ee hoose.
        || (isOwnerStaffOf(resource.data.schoolCode) && resource.data.accountType == 'staff'
            && request.resource.data.schoolCode == resource.data.schoolCode
            && request.resource.data.accountType == resource.data.accountType)
        // KU MEEL GAADH AH (2026-08-16, role-backfill audit): doc-yo hore loo
        // abuuray (ka hor "role" la darin handleSaveUser) waxay leeyihiin
        // "title" kaliya, ma laha "role" — RequireRole.jsx wuxuu xannibaa
        // owner-ka doc-kaas leh Finance/Reports/Users/Trash (bootstrap
        // deadlock: isOwnerStaffOf-na waxay u baahan tahay ROLE-KIISA HADDA,
        // sidaas darteed lama qori karo "role"-kiisa naftiisa via qaybta kore
        // ee self-update, kaas oo kaliya u ogolaanaya childrenIds). Halkan
        // waxaa loo ogolaanayaa isticmaale inuu naftiisa ku daro "role" KALIYA
        // haddii uu weli maqan yahay — ma bedeli karo mid horeba jira (ma aha
        // privilege-escalation), midna ma taaban karo field kale. TIRTIR
        // qaybtan marka backfill-ka dhammaan schools-ka la dhammaystiro.
        || (request.auth.uid == userId
            && resource.data.accountType == 'staff'
            && !('role' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
            && request.resource.data.role in ['owner', 'teacher'])
      );
      // Ma tirtiro Firebase Auth account-ka (SDK-ga browser-ku uma oggola —
      // waa loo baahan yahay Admin SDK/backend), laakiin tirtiridda doc-kan
      // waa in ay xannibto gelitaanka oo dhan (fiiri firebase/staff.js:
      // removeStaffDoc) — ma iska saari karo naftaada.
      allow delete: if isSignedIn() && isOwnerStaffOf(resource.data.schoolCode)
        && resource.data.accountType == 'staff'
        && request.auth.uid != userId;
    }

    // ===== schools (magaca, logo-ga, fees-by-grade, sanadka waxbarasho,
    // notification prefs ee dugsiga) — doc id-gu waa schoolCode-ka lafteeda
    // (deterministic, fiiri firebase/schools.js). Akhris: qof kasta oo isku
    // dugsi ah (shaqaale + waalid — magaca/logo-ga waa in waalidku sidoo
    // kale arkaa). Qoris: owner kaliya, la mid ah bogga "Settings" ee UI-gu
    // owner-only u yahay.
    match /schools/{schoolCode} {
      allow read: if isSignedIn() && me().schoolCode == resource.data.schoolCode;
      // MUHIIM (security fix, 2026-08-01): waxaa lagu xaddiday doc ID-ga
      // dhabta ah (path variable "schoolCode"), ma aha field-ka
      // request.resource.data.schoolCode — hore waxaa suurtagal ahaa in
      // owner dugsi A ah uu ku qoro/burburiyo doc-ka schools/{dugsi B} isaga
      // oo isticmaalaya schoolCode-kiisa (A) gudaha payload-ka.
      allow create, update: if isStaffOf(schoolCode) && me().role == 'owner';
      allow delete: if false;
    }

    // ===== students =====
    // Akhris: macallinku KALIYA arday fasalkiisa ah (isMyClassData, Students
    // audit 2026-08-03 — hore waxay ahayd isStaffOf oo dhan-dugsi ah, taasoo
    // u oggolaan jirtay macallin uu SDK-ga si toos ah ugu akhriyo xogta
    // lacageed/shakhsi ee ardayda fasallada kale). Owner-ku wuu arkaa
    // dhammaantood (isMyClassData -> isOwnerStaffOf). Waalidka runtida ah ee
    // ilmahan (childrenIds) sidoo kale — raadinta Diiwaan ID marka ilmo la
    // xirayo waxay isticmaashaa collection-ka 'studentLookup' (fiiri hoos).
    match /students/{studentDocId} {
      allow read: if isMyClassData(resource.data.schoolCode, resource.data.get('classTeacherId', null))
        || isParentOfStudent(resource.data.schoolCode, studentDocId);
      // Abuurid/wax-ka-beddel/tirtir (soft iyo joogto) waa owner-kaliya —
      // xogta ardayga waxaa ku jira lacagta (feeAmount/feeType/discountPercent)
      // ee horeba Finance-ku owner-kaliya u yeelay; macallinku ma laha sabab
      // uu si toos ah u wax-ka-beddelo doc-ka ardayga (xaadiris/buundo/Quraan
      // waxay ku jiraan collections gaar ah oo horeba isMyClassData ku xaddan).
      allow create, update: if isOwnerStaffOf(request.resource.data.schoolCode);
      allow delete: if isOwnerStaffOf(resource.data.schoolCode);
    }

    // ===== studentLookup =====
    // Doc gaaban oo kaliya leh {schoolCode, studentId, studentDocId} — waxaa
    // loo isticmaalaa raadinta Diiwaan ID (waalid marka ilmo la xirayo) iyada
    // oo aan loo baahnayn in Waalidku helo full document-ka ardayga ee
    // 'students'. Doc ID-gu waa deterministic: schoolCode_studentId.
    match /studentLookup/{lookupId} {
      allow read: if isStaffOf(resource.data.schoolCode) || isSameSchoolParent(resource.data.schoolCode);
      allow create, update: if isStaffOf(request.resource.data.schoolCode);
      allow delete: if isStaffOf(resource.data.schoolCode);
    }

    // ===== teachers =====
    // Akhris: shaqaale kasta (loo baahan yahay ClassWorkspace "jadwalka
    // maanta" ee macallin kasta arki karo). Qorista (add/edit) waxaa loo
    // xaddiday 'owner' kaliya, si la mid ah bogga "Macallimiinta" ee UI-gu
    // owner-only u yahay.
    match /teachers/{teacherId} {
      allow read: if isStaffOf(resource.data.schoolCode);
      allow create, update: if isStaffOf(request.resource.data.schoolCode) && me().role == 'owner';
      allow delete: if false;
    }

    // ===== classes =====
    // Akhris: shaqaale kasta (macallinku wuu u baahan yahay ClassWorkspace-
    // kiisa + liiska Classes.jsx, xitaa haddii UI-gu ku xaddidayo fasalkiisa
    // kaliya). Add/Edit/Delete: owner-kaliya (Teacher Role Scoping audit,
    // 2026-08-02) — hore waxay ahayd "shaqaale kastaa wuu maamuli karaa",
    // taasoo u ogolaan jirtay macallin inuu wax ka beddelo/tirtiro fasal
    // kale oo aan kiisa ahayn.
    // MUHIIM (bug fix, 2026-08-01): "create" waxaa loo isticmaali jiray
    // resource.data (kaas oo aan jirin marka doc-ku CUSUB yahay — Firestore
    // Rules "resource" waa null marka la abuurayo) — taasi waxay keenaysay in
    // "create" mar walba la XANNIBO si khalad ah, xitaa shaqaale sax ah.
    match /classes/{classDocId} {
      allow read: if isStaffOf(resource.data.schoolCode);
      allow update, delete: if isOwnerStaffOf(resource.data.schoolCode);
      allow create: if isOwnerStaffOf(request.resource.data.schoolCode);
    }

    // ===== subjects =====
    // Akhris: shaqaale kasta. Add/Edit/Delete: owner-kaliya (Teacher Role
    // Scoping audit, 2026-08-02) — hore waxay ahayd "shaqaale kastaa wuu
    // maamuli karaa", la mid ahayd classes ka hor intii aan taas la xaddidin.
    match /subjects/{subjectId} {
      allow read: if isStaffOf(resource.data.schoolCode);
      allow update, delete: if isOwnerStaffOf(resource.data.schoolCode);
      allow create: if isOwnerStaffOf(request.resource.data.schoolCode);
    }

    // ===== exams ===== (qeexidda imtixaanka — fiiri examMarks ee buundada
    // ardaygu ku qaatay).
    // Waalidku wuxuu akhrin karaa KELIYA imtixaannada fasalka ilmihiisa
    // (isla qaabka subscribeToClassExamsForParent, fiiri firebase/exams.js)
    // — ma aha dhammaan imtixaanada dugsiga.
    // Qoris (Exams audit, 2026-08-04 — user-reported gap): hore create/update/
    // delete waxay ahaayeen "isStaffOf" oo qura, taasoo u ogolaan jirtay
    // macallin kasta inuu abuuro/wax-ka-beddelo/tirtiro imtixaan macallin
    // KALE, xitaa haddii aanu ahayn fasalkiisa gaarka ah — ka duwan
    // examMarks/attendanceRecords/quranProgress oo horeba isMyClassData ku
    // xaddiday. Hadda isla mabda'a ayaa la isticmaalayaa: macallinku KALIYA
    // wuu maamuli karaa imtixaannada fasalkiisa (classTeacherId, denormalized
    // fiiri SchoolDataContext.jsx: addExam/updateExam/updateClass), owner-ku
    // dhammaantiis.
    match /exams/{examId} {
      allow read: if isStaffOf(resource.data.schoolCode) || isParentOfClass(resource.data.schoolCode, resource.data.get('classId', null));
      allow create, update: if isMyClassData(request.resource.data.schoolCode, request.resource.data.get('classTeacherId', null));
      allow delete: if isMyClassData(resource.data.schoolCode, resource.data.get('classTeacherId', null));
    }

    // ===== attendanceRecords ===== (doc id: "{date}_{studentId}")
    // Akhris: owner wuxuu arkaa dhammaantiisa; macallinku wuxuu KALIYA arkaa
    // records-ka fasalladiisa (classTeacherId, Teacher Firestore Hardening
    // 2026-08-02, fiiri isMyClassData kore).
    // Qoris (faafinta 3aad, 2026-08-02 — ClassWorkspace audit): hore waxay
    // ahayd "isStaffOf" oo qura (shaqaale kastaa wuu qori karaa xitaa fasal
    // aanu kiisa ahayn, iyadoo lagu kalsoonaaday in UI-gu (Attendance.jsx)
    // xakameeyo liiska ardayda — laakiin ClassWorkspace.jsx wuxuu ku suurta-
    // geliyay macallin inuu si toos ah URL (classId) ugu maro fasal kale oo
    // uu QORI karo). Hadda isla "isMyClassData" ee reads-ku isticmaalaan
    // ayaa write-ga sidoo kale xakamaya — macallinku KALIYA wuu qori karaa
    // record classTeacherId-giisu la mid yahay isaga; owner wuu qori karaa
    // dhammaantiis. (Backfill-ka hore ee la sameeyay hal-mar-kii ah — haddii
    // teacher, ma aha owner, uu socodsiiyo backfill-ka — hadda wuxuu guuleysan
    // doonaa kaliya records-ka fasalkiisa; kuwa kale waxay sii ahaan doonaan
    // null/undefined ilaa owner uu galo, taasoo ah dhaqan ammaan ah oo la
    // aqbalay, ma aha khalad.)
    match /attendanceRecords/{recordId} {
      allow read: if isMyClassData(resource.data.schoolCode, resource.data.get('classTeacherId', null))
        || isParentOfStudent(resource.data.schoolCode, resource.data.studentId);
      allow create, update: if isMyClassData(request.resource.data.schoolCode, request.resource.data.get('classTeacherId', null));
      allow delete: if false;
    }

    // ===== staffRoster ===== — liiska shaqaalaha aan macallimiinta ahayn
    // (Maamule, Xisaabiye, Ilaaliye, iwm) ee bogga Attendance tabka "Staff".
    // Akhris: shaqaale kasta. Add/Edit/Delete: owner-kaliya (Teacher Role
    // Scoping audit, 2026-08-02) — hore la mid ahayd classes/subjects ka hor
    // intii aan taas la xaddidin.
    match /staffRoster/{rosterId} {
      allow read: if isStaffOf(resource.data.schoolCode);
      allow update, delete: if isOwnerStaffOf(resource.data.schoolCode);
      allow create: if isOwnerStaffOf(request.resource.data.schoolCode);
    }

    // ===== staffAttendanceRecords ===== (doc id: "{category}_{date}_{personId}")
    // Akhris: shaqaale kasta (staff-only, ma jiro akhris waalid — kama
    // duwana attendanceRecords ee ardayda). Qoris: owner-kaliya (Attendance
    // audit, 2026-08-03 — hore waxay ahayd isStaffOf, taasoo u oggolaan
    // jirtay macallin uu beddelo xaaladda macallin/shaqaale KALE; isla
    // mabda'a staffRoster kore, oo horeba owner-kaliya u yeelay).
    match /staffAttendanceRecords/{recordId} {
      allow read: if isStaffOf(resource.data.schoolCode);
      allow create, update: if isOwnerStaffOf(request.resource.data.schoolCode);
      allow delete: if false;
    }

    // ===== examMarks ===== (doc id: "{examId}_{studentId}")
    // Akhris (Teacher Firestore Hardening, faafinta labaad 2026-08-02):
    // macallinku wuxuu KALIYA arkaa buundooyinka fasalladiisa (classTeacherId,
    // isMyClassData kore) — owner wuu arkaa dhammaantiisa.
    // Qoris (faafinta 3aad, 2026-08-02 — ClassWorkspace audit): isla mabda'a
    // attendanceRecords kore — macallinku KALIYA wuu qori karaa buundooyinka
    // fasalkiisa (isMyClassData), si ClassWorkspace.jsx uusan si toos ah URL
    // ugu marin karin fasal kale oo uu buundo ka qori karo.
    match /examMarks/{recordId} {
      allow read: if isMyClassData(resource.data.schoolCode, resource.data.get('classTeacherId', null))
        || isParentOfStudent(resource.data.schoolCode, resource.data.studentId);
      allow create, update: if isMyClassData(request.resource.data.schoolCode, request.resource.data.get('classTeacherId', null));
      allow delete: if false;
    }

    // ===== quranProgress ===== (doc id: "{date}_{studentId}")
    // Akhris (Teacher Firestore Hardening, faafinta labaad 2026-08-02): isla
    // mabda'a examMarks kore. Qoris (faafinta 3aad): isla mabda'a.
    match /quranProgress/{recordId} {
      allow read: if isMyClassData(resource.data.schoolCode, resource.data.get('classTeacherId', null))
        || isParentOfStudent(resource.data.schoolCode, resource.data.studentId);
      allow create, update: if isMyClassData(request.resource.data.schoolCode, request.resource.data.get('classTeacherId', null));
      allow delete: if false;
    }

    // ===== quranTargets =====
    // Akhris (Teacher Firestore Hardening, faafinta labaad 2026-08-02): isla
    // mabda'a examMarks kore. Qoris (faafinta 3aad): isla mabda'a.
    match /quranTargets/{targetId} {
      allow read: if isMyClassData(resource.data.schoolCode, resource.data.get('classTeacherId', null))
        || isParentOfStudent(resource.data.schoolCode, resource.data.studentId);
      allow create, update: if isMyClassData(request.resource.data.schoolCode, request.resource.data.get('classTeacherId', null));
      allow delete: if false;
    }

    // ===== messages (Waalid <-> Shaqaale) =====
    match /messages/{messageId} {
      allow read: if isStaffOf(resource.data.schoolCode) || isParentOfStudent(resource.data.schoolCode, resource.data.studentId);

      allow create: if
        (isStaffOf(request.resource.data.schoolCode)
          && request.resource.data.senderRole == 'staff'
          && request.resource.data.senderId == request.auth.uid)
        ||
        (isParentOfStudent(request.resource.data.schoolCode, request.resource.data.studentId)
          && request.resource.data.senderRole == 'parent'
          && request.resource.data.senderId == request.auth.uid);

      // Kaliya calaamadinta "la akhriyay" (readByStaff/readByParent) ayaa la
      // ogolaanayaa — qoraalka fariinta lama badali karo.
      allow update: if
        (isStaffOf(resource.data.schoolCode)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByStaff']))
        ||
        (isParentOfStudent(resource.data.schoolCode, resource.data.studentId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByParent']));

      allow delete: if false;
    }

    // ===== financeExpenses / financeIncome =====
    // Finance-ka OO DHAN waa owner-kaliya (Teacher Role Scoping audit,
    // 2026-08-02) — hore "isStaffOf" ayaa la isticmaali jiray, taasoo u
    // ogolaan jirtay macallin inuu Firestore SDK-ka si toos ah uga akhriyo
    // xogta maaliyadeed xitaa haddii UI-ga/route-ka Finance.jsx laga qariyay.
    match /financeExpenses/{expenseId} {
      allow read: if isOwnerStaffOf(resource.data.schoolCode);
      allow create: if isOwnerStaffOf(request.resource.data.schoolCode);
      allow update, delete: if false;
    }
    match /financeIncome/{incomeId} {
      allow read: if isOwnerStaffOf(resource.data.schoolCode);
      allow create: if isOwnerStaffOf(request.resource.data.schoolCode);
      allow update, delete: if false;
    }

    // ===== classFees ===== — qeexidda safka (name/students/total/discount)
    // KALIYA, balance-ku KUMA jiro halkan (waxaa laga soo xisaabiyaa
    // "feePayments" ee hoose, fiiri SchoolDataContext.jsx).
    match /classFees/{rowId} {
      allow read: if isOwnerStaffOf(resource.data.schoolCode);
      allow create: if isOwnerStaffOf(request.resource.data.schoolCode);
      allow update, delete: if false;
    }

    // ===== feePayments ===== — diiwaan (ledger) bixin kasta, APPEND-ONLY:
    // marna lama badali karo, lamana tirtiri karo (sixitaanku waxaa lagu
    // sameeyaa diiwaan celceliya, ma aha in taariikhda la tafatiro).
    // Waalidku wuxuu akhrin karaa KELIYA bixinnada ilmihiisa, oo KELIYA
    // feeType=='student' (safafka fasalku ma lahan studentId dhab ah —
    // sidaas darteed waxaa lagu xaddiday nooca doc-ga ka hor inta aan
    // la eegin studentId, si aan looga fogaan khalad "field missing" ah).
    // Staff-ka: owner-kaliya (fiiri financeExpenses kore).
    match /feePayments/{paymentId} {
      allow read: if isOwnerStaffOf(resource.data.schoolCode)
        || (resource.data.feeType == 'student' && isParentOfStudent(resource.data.schoolCode, resource.data.studentId));
      allow create: if isOwnerStaffOf(request.resource.data.schoolCode);
      allow update, delete: if false;
    }

    // ===== financeSalaries ===== — diiwaan (ledger), isla habka feePayments
    // (kore): waxaa la abuuraa KALIYA marka mushahar la bixiyo, marnaba lama
    // beddelo — xaaladda "Sugaya" ma aha doc halkan, waxaa laga soo
    // xisaabiyaa (derive) client-ka (fiiri utils/staffSalary.js).
    match /financeSalaries/{salaryId} {
      allow read: if isOwnerStaffOf(resource.data.schoolCode);
      allow create: if isOwnerStaffOf(request.resource.data.schoolCode);
      allow update, delete: if false;
    }

    // ===== financeDiscounts / financeDocuments ===== — diiwaan, APPEND-ONLY.
    match /financeDiscounts/{discountId} {
      allow read: if isOwnerStaffOf(resource.data.schoolCode);
      allow create: if isOwnerStaffOf(request.resource.data.schoolCode);
      allow update, delete: if false;
    }
    match /financeDocuments/{documentId} {
      allow read: if isOwnerStaffOf(resource.data.schoolCode);
      allow create: if isOwnerStaffOf(request.resource.data.schoolCode);
      allow update, delete: if false;
    }

    // ===== notifications =====
    // Fiiri notifications.js: "createFeeNotification"/"createAbsentNotification"
    // waxay isticmaalaan setDoc si ay ugu dib-u-cusboonaysiiyaan (refresh) hal
    // doc-ID oo go'an marar badan (mar kasta oo baaqigu/maqnaanshuhu dib loo
    // eego) — sidaas darteed shaqaalaha waa in ay si buuxda u update-gareyn
    // karaan (ma aha kaliya calaamadinta readByStaff). Waalidku wuxuu kaliya
    // beddeli karaa "readByParent".
    // Akhris (Teacher Firestore Hardening, 2026-08-02): type=='fee' waa
    // owner-kaliya (isla mabda'a financeExpenses iwm — macallinku gebi
    // ahaanba wuu ka mamnuucan yahay lacagta); noocyada kale (tusaale
    // 'absent') waxaa lagu xaddidayaa fasalka macallinka (isMyClassData,
    // classTeacherId).
    // Qoris (faafinta 3aad, 2026-08-02 — ClassWorkspace audit): hore
    // create/update-ku waxay ahaayeen "isStaffOf" oo qura (isla dhibaatada
    // attendanceRecords ee kore — ClassWorkspace.jsx wuxuu ku suurta-geliyi
    // karay macallin inuu ogeysiin maqnaansho ka abuuro fasal kale). Hadda
    // isla type-branch-ka reads-ku isticmaalaan ayaa create/update-ba
    // xakamaya: 'fee' waa owner-kaliya (macallinku marnaba ma abuuri karo
    // xitaa haddii classTeacherId la beddelo), 'absent' waxaa lagu xaddidayaa
    // isMyClassData. "setDoc" dib-u-cusboonaysiinta (fiiri notifications.js:
    // createAbsentNotification) marka doc-gu horeba jiro waxay ku dhacaan
    // "update" ma aha "create" (Firestore rules), sidaas darteed labaduba
    // isla hab ayaa loo xaddidayaa si aan meel ka maqnayn.
    match /notifications/{notificationId} {
      allow read: if
        (resource.data.type == 'fee'
          ? isOwnerStaffOf(resource.data.schoolCode)
          : isMyClassData(resource.data.schoolCode, resource.data.get('classTeacherId', null)))
        || isParentOfStudent(resource.data.schoolCode, resource.data.studentId);

      allow create: if
        request.resource.data.type == 'fee'
          ? isOwnerStaffOf(request.resource.data.schoolCode)
          : isMyClassData(request.resource.data.schoolCode, request.resource.data.get('classTeacherId', null));

      allow update: if
        (request.resource.data.type == 'fee'
          ? isOwnerStaffOf(request.resource.data.schoolCode)
          : isMyClassData(request.resource.data.schoolCode, request.resource.data.get('classTeacherId', null)))
        ||
        (isParentOfStudent(resource.data.schoolCode, resource.data.studentId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByParent']));

      allow delete: if isStaffOf(resource.data.schoolCode);
    }

    // Wax kasta oo aan kor lagu qorin — xayiran si toos ah.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
